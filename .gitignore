# ─── Build outputs ────────────────────────────────────────────────────────────
dist
dist-ssr
build
out

# ─── Dependencies ─────────────────────────────────────────────────────────────
node_modules

# ─── Environment & secrets ────────────────────────────────────────────────────
# Never commit environment files — they may contain gateway URLs, auth tokens,
# API keys, or other secrets.
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env.staging
.env.staging.local
*.local

# Generic secret file patterns
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
secrets.json
secrets.yaml
secrets.yml
credentials.json
credentials.yaml
credentials.yml
auth.json
config.local.json
config.local.ts

# ─── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─── Test & coverage ──────────────────────────────────────────────────────────
coverage/
.nyc_output/
*.lcov

# ─── Cache & temp ─────────────────────────────────────────────────────────────
.cache/
.parcel-cache/
.turbo/
.eslintcache
.stylelintcache
*.tsbuildinfo
tmp/
temp/

# ─── OS files ─────────────────────────────────────────────────────────────────
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# ─── Editors & IDEs ───────────────────────────────────────────────────────────
# VS Code — allow shared extensions recommendation, block personal settings
.vscode/*
!.vscode/extensions.json

# JetBrains (WebStorm, IntelliJ)
.idea/
*.iml
*.iws
*.ipr

# Vim / Neovim
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.nvimrc.local

# Cursor
.cursor/

# ─── Package manager artifacts ────────────────────────────────────────────────
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# ─── Vite / tooling ───────────────────────────────────────────────────────────
.vite/

# ─── Server / SQLite ──────────────────────────────────────────────────────────
server/data/     # SQLite database files — never commit user data
server/dist/     # Compiled server output

# ─── Deployment / hosting ─────────────────────────────────────────────────────
.vercel
.netlify
.firebase/
.amplify/
